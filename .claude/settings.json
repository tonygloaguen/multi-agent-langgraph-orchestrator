{
  "permissions": {
    "allow": [
      "Read:*",
      "Bash:git:*",
      "Bash:docker:*",
      "Bash:python3:*",
      "Bash:pip:*",
      "Bash:ruff:*",
      "Bash:mypy:*",
      "Bash:pytest:*",
      "Bash:make:*",
      "Write:*.py",
      "Write:*.md",
